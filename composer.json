{
    "name": "pub/campusmate",
    "description": "PUB CampusMate — Smart Campus Companion with Academic Planning, Course Registration, and AI Helpdesk for Pundra University of Science & Technology",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "PUB CampusMate Engineering Team",
            "email": "campusmate@pub.ac.bd"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/auth.php",
            "app/Helpers/csrf.php",
            "app/Helpers/validation.php",
            "app/Helpers/response.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-env": "php scripts/check_environment.php",
        "verify-db": "php scripts/verify_database.php",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
