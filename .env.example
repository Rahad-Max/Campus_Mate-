# =====================================================================
# PUB CampusMate — Environment Configuration File
# Copy this file to .env and adjust your local settings.
# =====================================================================

# Application Configuration
APP_NAME="PUB CampusMate"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost/pub-campusmate/public"
APP_TIMEZONE="Asia/Dhaka"

# Database Configuration (XAMPP / MySQL / MariaDB)
# Note: In default XAMPP setups, DB_PORT is 3306. If your MySQL runs on a custom port, set it here (e.g. 3307).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=pub_campusmate
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_NAME=pub_campusmate_session
APP_KEY="base64:pubCampusMateSecureKeyPlaceholder2026="

# Academic Credit Policy Defaults (Configurable University Rules)
CREDIT_MIN_PER_SEMESTER=9.0
CREDIT_MAX_PER_SEMESTER=18.0
CREDIT_PROBATION_MAX=12.0

# AI Helpdesk / Vector Integration (RAG)
AI_HELPDESK_DRIVER=mysql_fulltext
# Options: mysql_fulltext | external_service | chroma_db
AI_EMBEDDING_API_KEY=""
AI_HELPDESK_MODEL="gemini-1.5-flash"

# Mail & Notification (Optional)
MAIL_DRIVER=log
